# ESP32-S3-WROOM-1-N16R8: 16 MB flash. (8 MB PSRAM present but not enabled.)

CONFIG_IDF_TARGET="esp32s3"
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# !! ESP-IDF support connection intervals down to 2.5 ms. (non-BLE-spec compliant)
# REQUIRES ESP-IDF >= v5.5.5. Earlier versions do not declare this symbol; they
# only warn and then build a firmware that rejects the console's 5 ms interval.
# Details: docs/research/s3-bringup.md.
CONFIG_BT_CTRL_BLE_MIN_CONN_INTERVAL_ENABLE=y

# use usb cdc for transport layer
CONFIG_TRANSPORT_LAYER_USB_CDC=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# S3
CONFIG_HID_REPORT_INTERVAL=15

# FLASH - 16 MB module, dual-OTA layout
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16mb_s3.csv"

# PSRAM is deliberately NOT enabled: nothing in master allocates from it yet,
# and an unverified mode would only add boot-loop risk.
# See docs/research/s3-bringup.md before turning it on.

# This target has no BR/EDR radio, so the esp32-only BTDM_CTRL_MODE_* symbols do
# not apply here (assigning them was warning on every build).
CONFIG_BT_BLUEDROID_ENABLED=n
