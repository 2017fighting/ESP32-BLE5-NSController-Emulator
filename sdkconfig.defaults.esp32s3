# ESP32-S3-WROOM-1-N16R8: 16 MB flash. (8 MB PSRAM present but not enabled.)

CONFIG_IDF_TARGET="esp32s3"
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# !! ESP-IDF support connection intervals down to 2.5 ms. (non-BLE-spec compliant)
# REQUIRES ESP-IDF >= v5.5.5. Earlier versions do not declare this symbol; they
# only warn and then build a firmware that rejects the console's 5 ms interval.
# Details: docs/research/s3-bringup.md.
CONFIG_BT_CTRL_BLE_MIN_CONN_INTERVAL_ENABLE=y

# THE CONSOLE WILL NOT DISCOVER THE BOARD WITH EXTENDED ADVERTISING ENABLED.
#
# Measured on a real Switch 2 (2026-09-30): with CONFIG_BT_NIMBLE_EXT_ADV=y the
# board advertises through NimBLE's ble_gap_ext_adv_*() path; a phone (nRF
# Connect) sees that advertisement, marks it connectable and shows the correct
# Nintendo manufacturer data, but the console's grip-order screen never lists
# the controller. Switching to NimBLE's legacy advertising path
# (ble_gap_adv_start(), see ble_advertise() in main/src/device.c) makes the
# console discover and pair it immediately.
#
# sdkconfig.defaults sets EXT_ADV=y for every target; this override keeps the
# S3 on the legacy path. Evidence: docs/research/s3-bringup.md.
# CONFIG_BT_NIMBLE_EXT_ADV is not set

# The control plane rides UART0 — the CH9102 bridge, where ESP_LOG lives
# (ADR-0001, spec §2.1). The native OTG port is deliberately unused, so this
# supersedes the base's "use usb cdc for transport layer" for the S3 build.
CONFIG_TRANSPORT_LAYER_UART=y
CONFIG_CONTROL_UART_PORT=0
# 921600 is the spec's recommendation, not a measurement; bench ticket #33
# settles it and 115200 is the documented fallback (G-1).
CONFIG_CONTROL_UART_BAUD=921600
# -1 keeps UART0's chip-default IO_MUX pins (the CH9102).
CONFIG_CONTROL_UART_RX_PIN=-1
CONFIG_CONTROL_UART_TX_PIN=-1
CONFIG_PROTOCOL_LAYER_CONTROL=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# S3
CONFIG_HID_REPORT_INTERVAL=15

# FLASH - 16 MB module, dual-OTA layout
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16mb_s3.csv"

# PSRAM is deliberately NOT enabled: nothing in master allocates from it yet,
# and an unverified mode would only add boot-loop risk.
# See docs/research/s3-bringup.md before turning it on.

# This target has no BR/EDR radio, so the esp32-only BTDM_CTRL_MODE_* symbols do
# not apply here (assigning them was warning on every build).
CONFIG_BT_BLUEDROID_ENABLED=n
